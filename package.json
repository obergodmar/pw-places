{
  "name": "pw-places",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && next dev",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --audit-level=low",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/otel": "2.1.3",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.3.6",
    "pannellum": "2.5.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
